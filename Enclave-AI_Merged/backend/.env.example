# Copy to ".env" and change the secrets.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-string

OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
AVAILABLE_MODELS=qwen2.5:7b-instruct-q4_K_M,llama3.2:3b-instruct-q4_K_M
EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT_SECONDS=300
TOP_K=4

# Optional vision model for messy scans. Empty = Tesseract only.
VISION_MODEL=
VISION_FALLBACK_MIN_CHARS=40

# Windows only, if tesseract is not on PATH:
TESSERACT_CMD=

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
# MOCK_AGENT=true
